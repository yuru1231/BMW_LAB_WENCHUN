-
-    if (utAlloc == allocContainer.end())
-    {
-        UtAllocInfoItem_t rcAllocs;
-
-        rcAllocs.second = false;
-        rcAllocs.first =
-            std::vector<uint32_t>(m_utAllocs[ut].m_allocation.m_allocInfoPerRc.size(), 0);
-
-        std::pair<UtAllocInfoContainer_t::iterator, bool> result =
-            allocContainer.insert(std::make_pair(ut, rcAllocs));
-
-        if (result.second)
-        {
-            utAlloc = result.first;
