-     */
-    void GetSchedulingObjects(std::vector<Ptr<SatSchedulingObject>>& output);
-
-    /*
-     * Give the total sending time of all the BBFrames in all the slices.
-     * \return The total duration.
-     */
-    Time GetTotalDuration();
-
-    /*
