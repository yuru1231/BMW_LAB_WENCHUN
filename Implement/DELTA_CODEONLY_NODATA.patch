-/**
- * Enum for every possible command type
- */
-enum MacCommandType
-{
-    INVALID,
-    LINK_CHECK_REQ,
-    LINK_CHECK_ANS,
-    LINK_ADR_REQ,
-    LINK_ADR_ANS,
-    DUTY_CYCLE_REQ,
-    DUTY_CYCLE_ANS,
-    RX_PARAM_SETUP_REQ,
-    RX_PARAM_SETUP_ANS,
-    DEV_STATUS_REQ,
-    DEV_STATUS_ANS,
