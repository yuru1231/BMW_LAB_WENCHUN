-    Singleton<SatEnvVariables>::Get()->SetOutputVariables("test-sat-cno-estimator-unit",
-                                                          "last",
-                                                          true);
-
-    // create estimator with window 100 ms
-    Simulator::Schedule(Seconds(0.05),
-                        &SatBasicEstimatorLastTestCase::CreateEstimator,
