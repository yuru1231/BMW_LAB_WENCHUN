-        Simulator::Schedule(m_propagationDelay, &SatRtnArqTestCase::ReceiveAck, this, ack);
-    }
-    // Transmission error for ACK
-    else
-    {
-        m_ackErrors++;
-    }
-
-    return true;
-}
