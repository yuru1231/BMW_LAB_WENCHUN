-    ~SatFwdLinkSchedulerTimeSlicing();
-
-    /**
-     * Get next frame to be transmitted.
-     *
-     * \return Pointer to frame
-     */
-    virtual std::pair<Ptr<SatBbFrame>, const Time> GetNextFrame();
-
-    /**
-     * Remove all packets being treated.
-     */
-    virtual void ClearAllPackets();
-
-  private:
-  // ===== Debug sampling (NEW) =====
-    // ===== Debug sampling (NEW) =====
-  bool m_dbgEnable{false};
-  uint64_t m_dbgEvery{500};
-  uint64_t m_dbgCtr{0};
-  uint32_t m_dbgTopK{5};
-
-// ===== Served-bytes stats (NEW) =====
-bool m_statsEnable{false};
-uint64_t m_statsEvery{50};
-std::string m_statsFile{"/tmp/ts_sched_served_bytes.csv"};
-uint64_t m_roundId{0};
-std::unordered_map<uint32_t, uint64_t> m_servedBytes;
-std::ofstream m_statsOfs;
-    /**
-     * Do dispose actions.
-     */
-    void DoDispose(void);
-
-    /**
-     * Schedule BB Frames.
