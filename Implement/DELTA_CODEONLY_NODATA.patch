-    NS_LOG_FUNCTION(this << &ch);
-
-    m_channel = ch;
-
-    m_channel->Attach(this);
-
-    //
-    // This device is up whenever it is attached to a channel.  A better plan
-    // would be to have the link come up when both devices are attached, but this
-    // is not done for now.
-    //
-    NotifyLinkUp();
-    return true;
