-LoraConfirmedMessagesComponent::OnFailedReply(Ptr<LoraEndDeviceStatus> status,
-                                              Ptr<LoraNetworkStatus> networkStatus)
-{
-    NS_LOG_FUNCTION(this << networkStatus);
-
-    // Empty the Ack bit.
-    status->m_reply.frameHeader.SetAck(false);
-}
