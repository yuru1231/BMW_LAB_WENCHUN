-void
-SatFwdLinkSchedulerTimeSlicing::GetSchedulingObjects(std::vector<Ptr<SatSchedulingObject>>& output)
-{
-    NS_LOG_FUNCTION(this);
-
-    output.clear();
-
-    if (GetTotalDuration() >= m_periodicInterval)
-    {
-        return;
-    }
-
-    // Get scheduling objects from LLC
-    m_schedContextCallback(output);
-
-    // Debug sampling gate
-    const bool dbgOn = m_dbgEnable && (m_dbgEvery > 0);
-    const uint64_t roundCtr = m_dbgCtr;
-    if (dbgOn)
-    {
-        ++m_dbgCtr;
-    }
-    const bool doPrint = dbgOn && ((roundCtr % m_dbgEvery) == 0);
-
-    if (doPrint)
-    {
-        NS_LOG_UNCOND("### TS-SCHEDDBG v20260302 ctr=" << roundCtr << " ###");
-        NS_LOG_UNCOND("=== BEFORE SortSchedulingObjects ===");
-        for (auto& o : output)
-        {
-            NS_LOG_UNCOND("flowId=" << static_cast<uint32_t>(o->GetFlowId())
-                                    << " buf=" << o->GetBufferedBytes()
-                                    << " hol=" << o->GetHolDelay().GetSeconds());
-        }
-    }
-
-    // Keep original behavior (priority class sorting + optional additional criteria)
-    SortSchedulingObjects(output);
-
-    // OPTIONAL: if you want your QoS strict order to override the built-in sort, do it HERE.
-    // If you only want to OBSERVE without changing behavior, comment out this std::sort.
-    std::sort(output.begin(), output.end(),
-              [](const Ptr<SatSchedulingObject>& a, const Ptr<SatSchedulingObject>& b)
-              {
-                  const uint32_t fa = static_cast<uint32_t>(a->GetFlowId());
-                  const uint32_t fb = static_cast<uint32_t>(b->GetFlowId());
-                  if (fa != fb) return fa < fb;
-                  if (a->GetHolDelay() != b->GetHolDelay()) return a->GetHolDelay() > b->GetHolDelay();
-                  return a->GetBufferedBytes() > b->GetBufferedBytes();
-              });
-
-    if (doPrint)
-    {
-        NS_LOG_UNCOND("=== AFTER QoS SORT ===");
-        std::map<uint32_t, uint32_t> cnt;
-        for (auto& o : output)
-        {
-            cnt[static_cast<uint32_t>(o->GetFlowId())]++;
-        }
-        NS_LOG_UNCOND("=== FLOWID COUNT ===");
-        for (auto& kv : cnt)
-        {
-            NS_LOG_UNCOND("flowId=" << kv.first << " count=" << kv.second);
-        }
-    }
-}
