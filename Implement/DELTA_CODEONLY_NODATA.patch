-                  satrec.inclo,
-                  satrec.nodeo,
-                  satrec.argpo,
-                  satrec.mo,
-                  satrec.operationmode);
-
-            argpm = 0.0;
-            nodem = 0.0;
-            mm = 0.0;
-
-            dsinit(whichconst,
-                   cosim,
-                   emsq,
-                   satrec.argpo,
-                   s1,
-                   s2,
-                   s3,
-                   s4,
-                   s5,
-                   sinim,
-                   ss1,
-                   ss2,
-                   ss3,
-                   ss4,
-                   ss5,
-                   sz1,
-                   sz3,
-                   sz11,
-                   sz13,
-                   sz21,
-                   sz23,
-                   sz31,
-                   sz33,
