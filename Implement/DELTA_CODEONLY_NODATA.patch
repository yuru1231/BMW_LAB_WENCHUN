-TypeId
-LoraConfirmedMessagesComponent::GetTypeId(void)
-{
-    static TypeId tid = TypeId("ns3::LoraConfirmedMessagesComponent")
-                            .SetParent<LoraNetworkControllerComponent>()
-                            .AddConstructor<LoraConfirmedMessagesComponent>();
