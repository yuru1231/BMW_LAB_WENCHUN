-    : m_sendId(0),
-      m_recvId(0),
-      m_storeTime(MilliSeconds(300)),
-      m_deleteOnRead(false)
-{
-    NS_LOG_FUNCTION(this);
-}
-
-SatControlMsgContainer::SatControlMsgContainer(Time storeTime, bool deleteOnRead)
-    : m_sendId(0),
-      m_recvId(0),
-      m_storeTime(storeTime),
-      m_deleteOnRead(deleteOnRead)
-
-{
-    NS_LOG_FUNCTION(this);
