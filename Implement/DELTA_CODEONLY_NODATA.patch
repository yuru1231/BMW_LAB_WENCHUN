-                   tc,
-                   satrec.gsto,
-                   satrec.mo,
-                   satrec.mdot,
-                   satrec.no,
-                   satrec.nodeo,
-                   satrec.nodedot,
-                   xpidot,
-                   z1,
-                   z3,
-                   z11,
-                   z13,
-                   z21,
-                   z23,
-                   z31,
-                   z33,
-                   satrec.ecco,
-                   eccsq,
-                   em,
-                   argpm,
-                   inclm,
-                   mm,
-                   nm,
-                   nodem,
-                   satrec.irez,
