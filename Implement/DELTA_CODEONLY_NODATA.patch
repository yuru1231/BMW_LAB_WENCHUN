-
-    case CC_TYPE_RBDC:
-        result = (m_utAllocContainer.at(rcAlloc1.first)
-                      .m_request.m_allocInfoPerRc[rcAlloc1.second]
-                      .m_rbdcSymbols < m_utAllocContainer.at(rcAlloc2.first)
