-
-    mac->SetCrReceiveCallback(MakeCallback(&SatNcc::UtCrReceived, ncc));
-
-    mac->SetHandoverCallback(MakeCallback(&SatNcc::MoveUtBetweenBeams, ncc));
-
-    // Attach the Mac layer receiver to Phy
