-TypeId
-LoraAdrComponent::GetTypeId(void)
-{
-    static TypeId tid =
-        TypeId("ns3::LoraAdrComponent")
-            .AddConstructor<LoraAdrComponent>()
-            .SetParent<LoraNetworkControllerComponent>()
