-    // Control queue = rcIndex 0
-    SatRequestManager::QueueCallback queueCb;
-    for (EncapContainer_t::iterator it = m_encaps.begin(); it != m_encaps.end(); ++it)
-    {
-        // Set the callback for each RLE queue
