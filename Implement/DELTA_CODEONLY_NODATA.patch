-                llsConf.Get<SatLowerLayerServiceConf>()->GetRaAverageNormalizedOfferedLoadThreshold(
-                    i));
-        }
-    }
-
-    switch (m_fadingModel)
-    {
-    case SatEnums::FADING_MARKOV: {
