-     */
-    SatEnums::SatWaveFormBurstLength_t m_burstLength;
-
-    /**
-     * Container to store supported burst lengths.
-     */
-    BurstLengthContainer_t m_supportedBurstLengthsInSymbols;
-};
-
-} // namespace ns3
-
-#endif // SATELLITE_WAVE_FORM_CONF_H
