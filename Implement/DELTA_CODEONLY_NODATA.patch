-            if (!m_container[i].empty())
-            {
-                m_container[i].clear();
-            }
-        }
-        m_container.clear();
-    }
-
-    m_valuesInRow = 0;
-    m_lastValidPosition = 0;
-    m_numOfPasses = 0;
-    m_timeShiftValue = 0;
-}
