-    return std::max(std::max((m_fullGseHeaderSize + m_labelFieldLengthInBytes),
-                             (m_startGseHeaderSize + m_labelFieldLengthInBytes)),
-                    (std::max(m_endGseHeaderSize, m_continuationGseHeaderSize)));
