-
-    for (it = m_encaps.begin(); it != m_encaps.end(); ++it)
-    {
-        it->second->DoDispose();
-        it->second = 0;
-    }
-    m_encaps.clear();
-
-    for (it = m_decaps.begin(); it != m_decaps.end(); ++it)
