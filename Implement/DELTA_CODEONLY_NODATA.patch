-class SatStatsFrameLoadHelper : public SatStatsHelper
-{
-  public:
-    /**
-     * \enum UnitType_t
-     * \brief
-     */
-    typedef enum
-    {
-        /// Number of allocated symbols over total number of symbols in the frame.
-        UNIT_SYMBOLS = 0,
-        /// Number of scheduled users (i.e., UT).
