-    myPacket->RemoveHeader(mHdr);
-    myPacket->RemoveHeader(fHdr);
-    auto it = m_endDeviceStatuses.find(fHdr.GetAddress());
-    if (it != m_endDeviceStatuses.end())
-    {
-        return (*it).second;
-    }
-    else
-    {
-        NS_LOG_ERROR("EndDeviceStatus not found");
-        return 0;
-    }
-}
