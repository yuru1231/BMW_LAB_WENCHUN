-    {
-        if (m_enableFigureOutput)
-        {
-            iter->second->EnableFigureOutput("Fading trace",
-                                             "Time (s)",
-                                             "Fading (dB)",
-                                             "set key top right",
-                                             SatOutputFileStreamDoubleContainer::DECIBEL_AMPLITUDE,
-                                             Gnuplot2dDataset::LINES);
-        }
-        iter->second->WriteContainerToFile();
-    }
-}
