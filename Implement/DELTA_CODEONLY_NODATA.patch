-
-SatGseHeader::SatGseHeader()
-    : m_startIndicator(0),
-      m_endIndicator(0),
-      m_gsePduLengthInBytes(0),
-      m_fragmentId(0),
-      m_totalLengthInBytes(0),
-      m_protocolType(0),
-      m_labelByte(0),
-      m_crc(0),
-      m_fullGseHeaderSize(8),
-      m_startGseHeaderSize(8),
-      m_endGseHeaderSize(8),
-      m_continuationGseHeaderSize(3)
-{
-}
-
