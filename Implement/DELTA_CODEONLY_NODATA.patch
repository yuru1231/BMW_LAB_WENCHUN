-NS_OBJECT_ENSURE_REGISTERED(SatPPduHeader);
-
-SatPPduHeader::SatPPduHeader()
-    : m_startIndicator(0),
-      m_endIndicator(0),
-      m_ppduLengthInBytes(0),
-      m_fragmentId(0),
-      m_totalLengthInBytes(0),
