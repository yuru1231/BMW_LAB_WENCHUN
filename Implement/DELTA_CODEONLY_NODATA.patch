-bool
-SatCnoHelper::CheckDuplicate(Ptr<Node> node, SatEnums::ChannelType_t channel)
-{
-    for (cnoCustomParams_s params : m_customCno)
-    {
-        if (params.node == node && params.channelType == channel)
-        {
-            return true;
-        }
-    }
-    return false;
-}
