-
-void
-cross(double vec1[3], double vec2[3], double outvec[3])
-{
-    outvec[0] = vec1[1] * vec2[2] - vec1[2] * vec2[1];
-    outvec[1] = vec1[2] * vec2[0] - vec1[0] * vec2[2];
-    outvec[2] = vec1[0] * vec2[1] - vec1[1] * vec2[0];
-} // end cross
