-        NS_LOG_INFO(this << " Node " << utUserNode->GetId() << " does not support IPv4 protocol");
-    }
-    else if (ipv4->GetNInterfaces() >= 2)
-    {
-        const uint32_t identifier = GetIdentifierForUtUser(utUserNode);
-
-        /*
