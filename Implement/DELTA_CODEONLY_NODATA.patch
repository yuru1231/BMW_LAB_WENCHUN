-    cmd.AddValue("longitude", "Longitude of UT position (-180 ... 180)", longitude);
-    cmd.AddValue("altitude", "Altitude of UT position (meters)", altitude);
-    simulationHelper->AddDefaultUiArguments(cmd, inputFileNameWithPath);
-    cmd.Parse(argc, argv);
