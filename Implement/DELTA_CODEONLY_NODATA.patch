-                                          uint32_t codingRateDenominator) const;
-
-    /**
-     * Container of the waveforms
-     */
-    std::map<uint32_t, Ptr<SatWaveform>> m_waveforms;
-
-    /**
-     * Block error rate target for the waveforms. Default value
