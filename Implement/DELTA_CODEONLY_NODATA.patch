-    Ptr<SatSignalParameters> packetInterferedWith,
-    Ptr<SatSignalParameters> processedPacket,
-    double EsNo,
-    bool isRegenerative)
-{
-    NS_LOG_FUNCTION(this);
-
-    return EliminateInterferences(packetInterferedWith,
-                                  processedPacket,
-                                  EsNo,
-                                  isRegenerative,
-                                  0.0,
