-        m_antennaPatternMap.find(beamId);
-    if (agp == m_antennaPatternMap.end())
-    {
-        NS_FATAL_ERROR(
-            "SatAntennaGainPatternContainer::GetAntennaGainPattern - unvalid beam id: " << beamId);
-    }
-
-    return agp->second;
