-        mac->SetBeamSchedulerCallback(MakeCallback(&SatNcc::GetBeamScheduler, ncc));
-        mac->SetHandoverModule(handoverModule);
-    }
-
-    Singleton<SatTopology>::Get()
-        ->AddGwLayers(n, feederSatId, feederBeamId, satId, beamId, dev, llc, mac, phy);
-
-    return dev;
-}
